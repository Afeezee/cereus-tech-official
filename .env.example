# ─── Neon Postgres ─────────────────────────────────────────────
# Get from https://console.neon.tech → your project → Connection string (pooled)
DATABASE_URL=postgres://user:pass@ep-xxxx.aws.neon.tech/neondb?sslmode=require

# ─── Clerk (backend + frontend) ────────────────────────────────
# From https://dashboard.clerk.com → API Keys
# Frontend key (safe to expose) — starts with pk_test_ or pk_live_
VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Backend key (server-only) — MUST start with sk_test_ or sk_live_
# (a second pk_ value here will silently break admin authorization)
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── Admin allow-list ──────────────────────────────────────────
# Comma-separated Clerk user IDs OR email addresses that may access /admin
# You can leave this empty on first deploy and use the Clerk dashboard to
# get your userId, then update.
ADMIN_EMAILS=olagunjuafeez@gmail.com

# ─── Optional: brand/site ──────────────────────────────────────
VITE_SITE_NAME=Cereus Technologies
